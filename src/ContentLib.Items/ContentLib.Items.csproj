<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>com.github.LC-ContentLib.Items</AssemblyName>
    <AssemblyTitle>ContentLib.Items</AssemblyTitle>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- NuGet metadata -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>LC-ContentLib.Items</PackageId>
    <Description>Items module of the ContentLib API for Lethal Company.</Description>
    <Authors>$(Authors), Hamunii</Authors>
  </PropertyGroup>
  <ItemGroup>
    <None Include="./README.md" Pack="true" PackagePath="/" />
    <None Include="$(SolutionRoot)icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ContentLib.Core/ContentLib.Core.csproj" />
    <PackageReference Include="Evaisa.LethalLib" Version="*" />
  </ItemGroup>

</Project>
